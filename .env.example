# --- Claude ---------------------------------------------------------------
ANTHROPIC_API_KEY=
# Defaults are cost-aware: Sonnet for chat/tailoring, Haiku for light tasks.
# JOBIFY_MODEL=claude-sonnet-4-5
# JOBIFY_TAILOR_MODEL=claude-sonnet-4-5
# JOBIFY_CHEAP_MODEL=claude-haiku-4-5
# Comma-separated emails that are always admins (auto-approved).
# JOBIFY_ADMIN_EMAILS=pragyan4044@gmail.com

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Safe to expose.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Show "Continue with Google" (enable the Google provider in Supabase first).
# NEXT_PUBLIC_AUTH_GOOGLE=true

# --- Supabase Postgres (Connect → Session pooler). Keep secret. --------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# --- Optional -------------------------------------------------------------
# JOBIFY_LATEX_ENGINE=tectonic | pdflatex | docker
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# JOBIFY_DISCOVERY_TOKEN=
# JOBIFY_DISCOVERY_USER_ID=

# --- Gmail connection (optional) ----------------------------------------------
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENCRYPTION_KEY=
# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: http://localhost:3000/api/integrations/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

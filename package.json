{
  "name": "jobify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:secure": "node --env-file=.env.local node_modules/prisma/build/index.js db execute --file prisma/rls.sql --schema prisma/schema.prisma",
    "db:setup": "npm run db:push && npm run db:secure",
    "db:push": "node --env-file=.env.local node_modules/prisma/build/index.js db push"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.16.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "diff": "^9.0.0",
    "mammoth": "^1.13.0",
    "next": "15.5.4",
    "prisma": "^6.16.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@electric-sql/pglite-socket": "^0.2.20",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "@prisma/client@6.16.2": true,
    "@prisma/engines@6.16.2": true,
